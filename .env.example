# Copy to .env (scripts/quickstart.sh does it for you and fills VIBENOKIA_API_KEY).
# Never commit .env.

# --- Required ---
# Admin key: protects /ota/* and /g/* downloads. Generated by scripts/quickstart.sh.
VIBENOKIA_API_KEY=

# --- Claude ---
# Either an API key here, or run `docker compose run --rm server claude login` once
# (login state is kept in ./data/claude-home).
# ANTHROPIC_API_KEY=
# Extra flags for every Claude call. Default: none (Claude cannot use tools).
# Example (read-only exploration): VIBENOKIA_CLAUDE_ARGS=--allowedTools Read,Grep,Glob
# VIBENOKIA_CLAUDE_ARGS=
CLAUDE_TIMEOUT=120

# --- Pairing ---
# 1 = the phone may request a one-time pairing code (6 digits, 10 min, written to
# ./data/pair_code.txt). Set to 0 and restart once your phone is paired.
VIBENOKIA_PAIRING=1
# Optional: send the pairing code to your own Telegram chat as well.
# VIBENOKIA_OWNER_CHAT=
# Optional: only accept signatures made for this public address (host:port, comma-separated).
# VIBENOKIA_PUBLIC_HOST=
# Used to build install links (OTA). Your public http://host:port as the phone sees it.
VIBENOKIA_OTA_URL=http://127.0.0.1:8085

# --- Voice (optional; at least one for voice messages) ---
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Telegram bridge (optional) ---
# Use a SEPARATE bot made for this (BotFather). Do not reuse a bot something else polls.
# TELEGRAM_BOT_TOKEN=

# --- Features offered to the phone ---
# The app opens as a simple Claude chat. Comma-separated list of what phones MAY switch on
# in Settings > Features (and the only API routes that stay alive). Default: everything.
# telegram = contacts/messages via your bot, opencode = OpenCode chat (also needs VIBENOKIA_OPENCODE=1),
# sessions = chat history list, voice = voice messages, advanced = servers/update/key tools.
# VIBENOKIA_FEATURES=telegram,opencode,sessions,voice,advanced

# --- Off by default; read the README before enabling ---
VIBENOKIA_OPENCODE=0
VIBENOKIA_GAMES=0
